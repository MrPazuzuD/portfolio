---
import { profile } from '../data/cv';
import Icon from './Icon.astro';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="monitor depth">
      <div class="monitor__top mono" aria-hidden="true">
        <span><span class="rec"></span>Programme</span>
        <span class="hide-sm">marine_rimpot_2026.prproj</span>
        <span>1920 × 1080 · 25 i/s</span>
      </div>

      <div class="screen">
        <span class="safe" aria-hidden="true"></span>
        <div class="vu" aria-hidden="true">
          {['L', 'R'].map((ch, k) => (
            <div class="vu__ch">
              <div class="vu__bar" style={`--s:${k * -0.37}s`}>{Array.from({ length: 18 }, (_, i) => <i class={i > 14 ? 'r' : i > 11 ? 'y' : ''}></i>)}</div>
              <span class="mono">{ch}</span>
            </div>
          ))}
        </div>
        <div class="screen__inner">
          {profile.photo && <img class="photo" src={profile.photo} alt={`Photo de ${profile.firstName} ${profile.lastName}`} width="160" height="160" />}
          <p class="mono eyebrow">{profile.title}</p>
          <h1 id="hero-title">
            <span class="line">{profile.firstName}</span>
            <span class="line line--gold">{profile.lastName}</span>
          </h1>
          <p class="pitch">{profile.pitch}</p>
          <p class="now"><span class="now__item"><span class="dot" aria-hidden="true"></span>{profile.current}</span><span class="now__item"><Icon name="pin" />{profile.locationLabel}</span></p>

          <div class="cta">
            <a class="btn btn--gold" href={profile.cvPdf} download><Icon name="download" />Télécharger le CV</a>
            <a class="btn" href={profile.links.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin" />LinkedIn</a>
            <a class="btn" href={profile.links.github} rel="me noopener" target="_blank"><Icon name="github" />GitHub</a>
          </div>
        </div>
      </div>

      <p class="subs" aria-hidden="true"><span data-subs>[Bruit de clavier]</span></p>
      <div class="transport mono" aria-hidden="true">
        <span class="tc" data-tc>00:00:00:00</span>
        <span class="controls"><i>⏮</i><i class="play">▶</i><i>⏭</i></span>
        <span class="hint">Faites défiler pour lire ↓</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(1.5rem, 4vw, 3rem) 0 2rem; }
  .monitor {
    position: relative; border-radius: 20px;
    box-shadow: 0 40px 120px -40px rgb(0 0 0 / .8), inset 0 1px 0 rgb(255 255 255 / .04);
    overflow: hidden;
  }
  .monitor__top, .transport {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: .7rem 1.1rem; background: var(--panel);
  }
  .monitor__top { border-bottom: 1px solid var(--line); }
  .transport { border-top: 1px solid var(--line); }
  .rec {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--rec);
    margin-right: .5rem; vertical-align: middle; animation: blink 1.6s steps(2, start) infinite;
  }
  @keyframes blink { to { visibility: hidden; } }

  .screen {
    position: relative; padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.25rem, 6vw, 5rem) clamp(3rem, 8vw, 6.5rem);
    background:
      radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--crea) 22%, transparent), transparent 60%),
      radial-gradient(900px 500px at -10% 110%, color-mix(in srgb, var(--pro) 16%, transparent), transparent 60%),
      #0b0d13;
  }
  /* Repères de cadre "title safe" aux quatre coins */
  .safe { position: absolute; inset: 18px; pointer-events: none; opacity: .5;
    background:
      linear-gradient(var(--muted), var(--muted)) top left / 22px 1px,
      linear-gradient(var(--muted), var(--muted)) top left / 1px 22px,
      linear-gradient(var(--muted), var(--muted)) top right / 22px 1px,
      linear-gradient(var(--muted), var(--muted)) top right / 1px 22px,
      linear-gradient(var(--muted), var(--muted)) bottom left / 22px 1px,
      linear-gradient(var(--muted), var(--muted)) bottom left / 1px 22px,
      linear-gradient(var(--muted), var(--muted)) bottom right / 22px 1px,
      linear-gradient(var(--muted), var(--muted)) bottom right / 1px 22px;
    background-repeat: no-repeat;
  }
  .screen__inner { position: relative; display: grid; gap: 1.2rem; }
  .photo { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
  .eyebrow { color: var(--gold); font-size: .85rem; }
  h1 { font-size: clamp(3.2rem, 11vw, 8.5rem); font-weight: 700; letter-spacing: -0.045em; line-height: .92; text-shadow: 0 12px 40px rgb(0 0 0 / .6); }
  @media (prefers-reduced-motion: no-preference) {
    h1:hover .line { animation: rgb .5s steps(2) 2; }
    @keyframes rgb {
      0% { text-shadow: 3px 0 #ff3b5c, -3px 0 #3cc7b5; transform: translateX(1px); }
      50% { text-shadow: -4px 0 #ff3b5c, 4px 0 #a98bff; transform: translateX(-2px); }
      100% { text-shadow: none; transform: none; }
    }
  }
  .line { display: block; }
  .line--gold { color: var(--gold); }
  .pitch { font-size: clamp(1.1rem, 2.2vw, 1.4rem); max-width: 36ch; color: #d5d9e2; }
  .now { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; color: var(--muted); font-size: .98rem; }
  .now__item { display: inline-flex; align-items: center; gap: .5rem; }
  .now :global(svg) { width: 16px; height: 16px; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--pro); box-shadow: 0 0 0 4px color-mix(in srgb, var(--pro) 25%, transparent); }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .6rem; }

  .subs {
    position: absolute; left: 50%; bottom: 66px; translate: -50% 0; z-index: 2; margin: 0;
    max-width: 90%; text-align: center; pointer-events: none;
  }
  .subs span {
    display: inline-block; padding: .25rem .7rem; border-radius: 4px; background: rgb(0 0 0 / .72);
    color: #fff; font-size: clamp(.8rem, 1.6vw, .95rem); font-weight: 500; transition: opacity .3s;
  }
  .subs span.is-out { opacity: 0; }
  @media (max-width: 960px) { .subs { display: none; } }
  .tc { color: var(--text); font-variant-numeric: tabular-nums; }
  .controls { display: flex; gap: 1.2rem; font-style: normal; }
  .controls i { font-style: normal; opacity: .6; }
  .controls .play { color: var(--gold); opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .line { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
    .line--gold { animation-delay: .12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(30%); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(0); } }
  }
  /* Vumètres L/R : clin d'œil à la console de mixage */
  .vu { position: absolute; right: clamp(2rem, 6vw, 5rem); top: 50%; translate: 0 -50%; display: flex; gap: 1.1rem; }
  .vu__ch { display: grid; gap: .6rem; justify-items: center; }
  .vu__bar { display: flex; flex-direction: column-reverse; gap: 4px; }
  .vu__bar i { width: 34px; height: 9px; border-radius: 2px; background: color-mix(in srgb, var(--pro) 80%, transparent); }
  .vu__bar i.y { background: var(--gold); }
  .vu__bar i.r { background: var(--rec); }
  .vu__bar { -webkit-mask: linear-gradient(to top, #000 var(--lvl, 62%), #ffffff1f var(--lvl, 62%)); mask: linear-gradient(to top, #000 var(--lvl, 62%), #ffffff1f var(--lvl, 62%)); }
  @property --lvl { syntax: '<percentage>'; inherits: false; initial-value: 62%; }
  @media (prefers-reduced-motion: no-preference) {
    .vu__bar { animation: level 2.4s ease-in-out infinite; animation-delay: var(--s); }
    @keyframes level { 0% { --lvl: 40%; } 18% { --lvl: 78%; } 30% { --lvl: 55%; } 52% { --lvl: 88%; } 70% { --lvl: 48%; } 85% { --lvl: 70%; } 100% { --lvl: 40%; } }
  }
  @media (max-width: 960px) { .vu { display: none; } }

  @media (max-width: 640px) {
    .hide-sm, .hint { display: none; }
    .hero { padding-top: 1rem; }
    .screen { padding: 2rem 1.25rem; }
    .screen__inner { gap: .9rem; }
    h1 { font-size: 3.4rem; }
    .pitch { font-size: 1.05rem; }
    .now { font-size: .9rem; }
    .cta { margin-top: .2rem; }
    .cta .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
