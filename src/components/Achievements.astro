---
import { achievements } from '../data/achievements';
---
<dialog class="ach" data-ach-dialog aria-labelledby="ach-title">
  <div class="ach__head">
    <div>
      <p class="mono">Succès</p>
      <h2 id="ach-title"><span data-ach-count>0</span> / {achievements.length} débloqués</h2>
    </div>
    <button type="button" class="ach__close" data-ach-close aria-label="Fermer">✕</button>
  </div>
  <div class="ach__bar" aria-hidden="true"><i data-ach-bar></i></div>
  <ul class="ach__list">
    {achievements.map((a) => (
      <li data-ach={a.id}>
        <span class="ach__icon" aria-hidden="true"><span class="ach__emoji">{a.icon}</span><span class="ach__lock">🔒</span></span>
        <div><b>{a.title}</b><span>{a.hint}</span></div>
        <span class="ach__state mono" data-ach-state>Verrouillé</span>
      </li>
    ))}
  </ul>
  <p class="ach__foot mono">Progression gardée dans ce navigateur uniquement.</p>
</dialog>

<style>
  .ach {
    width: min(580px, calc(100% - 2rem)); max-height: min(84vh, 800px); padding: 0; color: var(--text);
    overflow: hidden; overscroll-behavior: contain;
    background: linear-gradient(180deg, #1c2231, #141924); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 40px 120px rgb(0 0 0 / .8);
  }
  .ach::backdrop { background: rgb(5 7 12 / .7); backdrop-filter: blur(4px); }
  .ach[open] { display: flex; flex-direction: column; animation: pop .3s cubic-bezier(.2,.7,.2,1); }
  @keyframes pop { from { opacity: 0; transform: translateY(14px) scale(.98); } }
  .ach__head { display: flex; justify-content: space-between; align-items: flex-start; padding: 1.4rem 1.4rem .8rem; }
  .ach__head .mono { color: var(--gold); font-size: .65rem; }
  .ach h2 { font-size: 1.5rem; margin-top: .2rem; }
  .ach__close { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); cursor: pointer; font-size: 1rem; }
  .ach__bar { margin: 0 1.4rem 1rem; height: 6px; border-radius: 3px; background: #0b0d13; overflow: hidden; }
  .ach__bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--gold), #ffde6b); transition: width .5s ease; }
  /* Seule la liste défile, jamais la page derrière */
  .ach__list { list-style: none; margin: 0; padding: .2rem 1rem 0; display: grid; gap: .5rem; overflow-y: auto; overscroll-behavior: contain; flex: 1; min-height: 0; }
  .ach__list li {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: .7rem .9rem .7rem .7rem;
    border-radius: 14px; background: #0f131bcc; border: 1px solid #ffffff0d;
  }
  .ach__list li:not(.is-on) b, .ach__list li:not(.is-on) div span { opacity: .6; }
  .ach__list li.is-on { border-color: color-mix(in srgb, var(--gold) 40%, transparent);
    background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 10%, #0f131b), #0f131bcc 60%); }
  /* Médaillon de trophée */
  .ach__icon {
    position: relative; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; flex: none;
    background: radial-gradient(circle at 35% 30%, #3a4256, #1a1f2c 70%);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / .12), inset 0 -3px 6px rgb(0 0 0 / .5), 0 0 0 2px #2a3142;
  }
  .ach__list .ach__emoji { font-size: 2rem; color: inherit; line-height: 1; filter: grayscale(1); opacity: .45; transition: filter .3s, transform .3s; }
  .ach__list .ach__lock { position: absolute; right: -4px; bottom: -4px; width: 22px; height: 22px; display: grid; place-items: center; font-size: .7rem;
    border-radius: 50%; background: #0b0d13; box-shadow: 0 0 0 2px #2a3142; }
  .is-on .ach__icon {
    background: radial-gradient(circle at 35% 30%, #fff3c2, var(--gold) 45%, #a37200 100%);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / .6), inset 0 -3px 6px rgb(0 0 0 / .3), 0 0 0 2px #ffd968, 0 0 18px color-mix(in srgb, var(--gold) 55%, transparent);
  }
  .ach__list .is-on .ach__emoji { filter: drop-shadow(0 2px 2px rgb(0 0 0 / .35)); opacity: 1; transform: scale(1.05); }
  .ach__list .is-on .ach__lock { display: none; }
  .ach__list b { display: block; font-family: var(--font-title); font-size: 1.02rem; }
  .ach__list div span { font-size: .85rem; color: var(--muted); }
  .ach__state { font-size: .58rem; }
  .is-on .ach__state { color: var(--gold); }
  .ach__foot { padding: 1rem 1.4rem 1.3rem; font-size: .6rem; text-transform: none; }
</style>
