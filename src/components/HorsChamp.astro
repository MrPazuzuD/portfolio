---
import { music, games, profile } from '../data/cv';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

// Niveaux de départ des faders : tout est en haut, à quelques crans près
const levels = music.genres.map((_, i) => 82 + ((i * 7) % 15));
// Jaquettes maison : couleurs d'ambiance, aucun visuel officiel
const covers: Record<string, [string, string]> = {
  'Red Dead Redemption 2': ['#b3261e', '#f29d38'],
  'Hunt: Showdown': ['#2d3a1f', '#8a6d3b'],
  'GTA': ['#e83e8c', '#18b5c9'],
  'Dead by Daylight': ['#3a0a0a', '#c0392b'],
  'The Wolf Among Us': ['#3d1f6e', '#f2c14e'],
  'Les jeux Telltale': ['#2b2b2b', '#9aa3b5'],
  'Overwatch': ['#f99e1a', '#43484c'],
  '007 First Light': ['#0b0b0b', '#c9a227'],
  'Satisfactory': ['#f58220', '#1f6f78'],
  'Age of Empires IV': ['#1e3a6e', '#d4a64a'],
  'Planet Zoo': ['#2e7d32', '#e5c34b'],
};
const gameList = [...games.favorites.map((g) => ({ g, fav: true })), ...games.others.map((g) => ({ g, fav: false }))];
---
<section class="section" id="hors-champ" aria-labelledby="hc-title">
  <div class="wrap">
    <SectionHead scene={4} label="Hors champ" title="Ce qui ne rentre pas dans une fiche de poste" id="hc-title">
      La musique, le montage et le jeu vidéo. C’est de là que vient la forme de ce site.
    </SectionHead>

    <!-- Console de mixage -->
    <article class="mixer depth reveal" aria-labelledby="mix-title">
      <div class="mixer__top">
        <div>
          <p class="mono k">A1 · Musique</p>
          <h3 id="mix-title">Ma console : tous les curseurs en haut</h3>
          <p class="txt">{music.text}</p>
        </div>
        <div class="side">
          <div class="inputs">
            <p class="mono k2">Entrées</p>
            <ul>{music.instruments.map((m) => <li><span class="led" aria-hidden="true"></span>{m}</li>)}</ul>
          </div>
          <div class="pl">
            <p class="mono k2">Playlist en aléatoire</p>
            <p class="pl__name">{music.playlist.name}</p>
            <p class="pl__count"><b>{music.playlist.count}</b> titres, tous genres confondus</p>
            {music.playlist.spotify && <a class="pl__link" href={music.playlist.spotify} target="_blank" rel="noopener">Écouter sur Spotify ↗</a>}
          </div>
          <a class="btn btn--crea" href={profile.links.youtube} target="_blank" rel="noopener"><Icon name="play" />Mes créations sur YouTube</a>
        </div>
      </div>

      <div class="strips" role="group" aria-label="Styles que j’écoute (faders réglables)">
        {music.genres.map((g, i) => (
          <div class="strip" style={`--lv:${levels[i]}`}>
            <span class="knob" aria-hidden="true" style={`--r:${(i * 37) % 120 - 60}deg`}></span>
            <span class="ms" aria-hidden="true"><i>M</i><i>S</i></span>
            <div class="fader">
              <span class="meter" aria-hidden="true"><i></i></span>
              <input type="range" min="0" max="100" value={levels[i]} aria-label={`Volume ${g}`} data-fader />
            </div>
            <span class="name">{g}</span>
          </div>
        ))}
      </div>
    </article>

    <div class="duo">
      <!-- Montage -->
      <article class="tile tile--edit depth reveal">
        <p class="mono k">V3 · Montage & stream</p>
        <h3>Je monte depuis 2020</h3>
        <div class="film" aria-hidden="true">
          <div class="film__strip">
            {Array.from({ length: 2 }).map(() => ['#3cc7b5', '#a98bff', '#f2b705', '#ff5a5f', '#4f8cff', '#a98bff', '#3cc7b5', '#f2b705'].map((c, k) => (
              <span class="frame" style={`--c:${c};--k:${k}`}></span>
            )))}
          </div>
        </div>
        <p class="txt">Vidéos YouTube et TikTok, lives Twitch, modération et serveurs Discord. Couper, rythmer, raconter : c’est le même réflexe que pour expliquer un logiciel à quelqu’un.</p>
        <div class="row">
          <a class="btn" href={profile.links.youtube} target="_blank" rel="noopener"><Icon name="play" />YouTube</a>
          <a class="btn" href={profile.links.twitch} target="_blank" rel="noopener"><Icon name="twitch" />Twitch</a>
        </div>
      </article>

      <!-- Jeux -->
      <article class="tile depth reveal">
        <p class="mono k">Chutier · Jeux vidéo</p>
        <h3>Ma ludothèque</h3>
        <ul class="games">
          {gameList.map(({ g, fav }) => {
            const [a, b] = covers[g] ?? ['#2a3142', '#9aa3b5'];
            return (
              <li class={`case tilt ${fav ? 'case--fav' : ''}`} style={`--a:${a};--b:${b}`}>
                {fav && <span class="star mono">★ Favori</span>}
                <span class="case__title">{g}</span>
              </li>
            );
          })}
          <li class="case case--more"><span class="case__title">Et plein d’autres…</span></li>
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .k { color: var(--crea); font-size: .7rem; }
  .k2 { font-size: .6rem; margin-bottom: .4rem; }
  h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .txt { color: #d5d9e2; max-width: 60ch; }
  .btn--crea { background: var(--crea); color: #120d22; border-color: var(--crea); }

  /* Console */
  .mixer { border-radius: 22px; padding: clamp(1.4rem, 3vw, 2.2rem); margin-bottom: 1.2rem;
    background: linear-gradient(180deg, rgb(255 255 255 / .04), transparent 30%), radial-gradient(800px 300px at 100% 0, color-mix(in srgb, var(--crea) 16%, transparent), transparent 70%), var(--panel); }
  .mixer__top { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; margin-bottom: 1.8rem; }
  .mixer__top > div:first-child { display: grid; gap: .8rem; align-content: start; }
  .side { display: grid; gap: 1rem; align-content: start; }
  .inputs ul { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; }
  .inputs li { display: flex; align-items: center; gap: .5rem; padding: .4rem .8rem; border-radius: 8px; background: #0c0f16; border: 1px solid var(--line); font-weight: 600; font-size: .92rem; }
  .led { width: 8px; height: 8px; border-radius: 50%; background: #39ff88; box-shadow: 0 0 8px #39ff88; }
  .pl { padding: .9rem 1rem; border-radius: 12px; background: #0c0f16; border: 1px solid var(--line); }
  .pl__name { font-family: var(--font-title); font-weight: 600; font-size: 1.15rem; }
  .pl__count { color: var(--muted); font-size: .9rem; }
  .pl__count b { color: var(--gold); font-family: var(--font-mono); }
  .side .btn { justify-self: start; }
  .pl__link { display: inline-block; margin-top: .6rem; font-weight: 600; font-size: .9rem; color: #1ed760; text-decoration: none; }
  .pl__link:hover { text-decoration: underline; }

  .strips {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 6px; padding: 14px;
    border-radius: 14px; background: linear-gradient(#0d1017, #090b10); border: 1px solid #000;
    box-shadow: inset 0 2px 10px rgb(0 0 0 / .7);
    overflow-x: auto;
  }
  .strip {
    display: grid; justify-items: center; gap: .6rem; padding: .7rem .2rem .8rem; min-width: 62px;
    border-radius: 10px; background: linear-gradient(180deg, #1d2330, #151a24); border: 1px solid #262d3c;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .06);
  }
  .knob {
    width: 28px; height: 28px; border-radius: 50%; position: relative;
    background: radial-gradient(circle at 35% 30%, #4a5368, #1b2029 70%); box-shadow: 0 2px 4px #000, inset 0 1px 0 #ffffff22;
    transform: rotate(var(--r));
  }
  .knob::after { content: ''; position: absolute; left: 50%; top: 3px; width: 2px; height: 9px; margin-left: -1px; background: var(--gold); border-radius: 1px; }
  .ms { display: flex; gap: 3px; }
  .ms i { font: 600 .55rem var(--font-mono); font-style: normal; width: 18px; height: 16px; display: grid; place-items: center; border-radius: 3px; background: #262d3c; color: var(--muted); }
  .ms i:last-child { background: color-mix(in srgb, var(--gold) 70%, #262d3c); color: #14110a; }
  .fader { position: relative; height: 170px; display: flex; gap: 6px; align-items: stretch; }
  .meter { width: 6px; border-radius: 3px; background: #0a0c11; overflow: hidden; display: flex; align-items: flex-end; }
  .meter i { width: 100%; height: calc(var(--lv) * 1%); background: linear-gradient(to top, #39ff88 0 60%, var(--gold) 60% 85%, var(--rec) 85%); transition: height .15s; }
  .fader input {
    writing-mode: vertical-lr; direction: rtl; width: 30px; height: 100%; margin: 0;
    appearance: none; -webkit-appearance: none; background: transparent; cursor: ns-resize;
  }
  .fader input::-webkit-slider-runnable-track { width: 4px; background: #05070b; border-radius: 2px; box-shadow: 0 0 0 1px #2a3142; }
  .fader input::-moz-range-track { width: 4px; background: #05070b; border-radius: 2px; }
  .fader input::-webkit-slider-thumb {
    -webkit-appearance: none; width: 30px; height: 16px; margin-left: -13px; border-radius: 3px;
    background: linear-gradient(#e9ecf2, #9aa3b5 45%, #c9ceda 55%, #8a93a6); box-shadow: 0 3px 6px #000;
  }
  .fader input::-moz-range-thumb { width: 30px; height: 16px; border: 0; border-radius: 3px; background: linear-gradient(#e9ecf2, #9aa3b5 45%, #c9ceda 55%, #8a93a6); box-shadow: 0 3px 6px #000; }
  .name { font-size: .7rem; font-weight: 600; text-align: center; line-height: 1.2; min-height: 2.4em; display: grid; place-items: center; }
  @media (prefers-reduced-motion: no-preference) {
    .meter i { animation: vu 1.3s ease-in-out infinite alternate; animation-delay: calc(var(--lv) * -23ms); }
    @keyframes vu { from { transform: translateY(18%); } to { transform: translateY(0); } }
  }

  /* Montage + jeux */
  .duo { display: grid; gap: 1.2rem; }
  .tile--edit { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 2.5rem; align-items: center; }
  .tile--edit > :not(.film) { grid-column: 1; }
  .tile--edit .film { grid-column: 2; grid-row: 1 / span 4; }
  .tile { display: grid; gap: 1.1rem; align-content: start; padding: clamp(1.4rem, 3vw, 2rem); border-radius: 22px; }
  .row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .tile--edit .film { padding: 18px 0; }
  .tile--edit .frame { width: 120px; height: 80px; }
  .film { overflow: hidden; border-radius: 8px; background: #050608; padding: 12px 0; position: relative; }
  .film::before, .film::after {
    content: ''; position: absolute; left: 0; right: 0; height: 6px; z-index: 1;
    background: repeating-linear-gradient(90deg, #d5d9e2 0 6px, transparent 6px 14px); opacity: .55;
  }
  .film::before { top: 3px; } .film::after { bottom: 3px; }
  .film__strip { display: flex; gap: 6px; width: max-content; }
  .frame {
    width: 86px; height: 56px; border-radius: 4px; flex: none;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 85%, #000), color-mix(in srgb, var(--c) 25%, #000));
    box-shadow: inset 0 0 0 1px #ffffff1a;
  }
  @media (prefers-reduced-motion: no-preference) {
    .film__strip { animation: roll 14s linear infinite; }
    @keyframes roll { to { transform: translateX(-50%); } }
  }

  .games { list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-flow: dense; gap: .8rem; }
  .case {
    position: relative; aspect-ratio: 3 / 4; border-radius: 10px; padding: .7rem; display: flex; flex-direction: column; justify-content: flex-end;
    background:
      linear-gradient(180deg, transparent 35%, rgb(0 0 0 / .75)),
      radial-gradient(circle at 80% 15%, color-mix(in srgb, var(--b) 85%, transparent), transparent 60%),
      linear-gradient(160deg, var(--a), color-mix(in srgb, var(--a) 40%, #000));
    border: 1px solid #ffffff1f; overflow: hidden;
    box-shadow: inset 0 1px 0 #ffffff33, 0 12px 24px -10px #000;
  }
  .case::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: linear-gradient(90deg, #0006, transparent); }
  .case__title { font-family: var(--font-title); font-weight: 700; font-size: .92rem; line-height: 1.15; text-shadow: 0 2px 6px #000; }
  .case--fav { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; outline: 2px solid var(--gold); outline-offset: 2px; }
  .case--more { background: repeating-linear-gradient(-45deg, #ffffff08 0 8px, transparent 8px 16px), var(--panel-2); justify-content: center; align-items: center; text-align: center; color: var(--muted); }
  .case--fav .case__title { font-size: clamp(1.3rem, 2.4vw, 1.9rem); }
  .star { position: absolute; top: .6rem; left: .7rem; font-size: .58rem; color: #14110a; background: var(--gold); padding: .15rem .45rem; border-radius: 5px; }
  .more { font-size: .65rem; }

  @media (max-width: 860px) {
    .mixer__top, .tile--edit { grid-template-columns: 1fr; }
    .tile--edit .film { grid-column: 1; grid-row: auto; }
    .games { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case--fav { grid-row: auto; min-height: 130px; }
    .case { aspect-ratio: 4 / 3; }
    .strips { grid-template-columns: repeat(12, 62px); }
  }
</style>
