---
// Raccord entre deux sections : bande de pellicule qui défile, ou égaliseur
interface Props { kind: 'film' | 'eq' | 'line'; words?: string[]; from?: number; to?: number; tilt?: number; tone?: 'gold' | 'pro' | 'crea' }
const { kind, words = [], from = 0, to = 1, tilt = -2, tone = 'gold' } = Astro.props;
const bars = Array.from({ length: 96 }, (_, i) => {
  const v = Math.abs(Math.sin(i * 0.37) * 0.55 + Math.sin(i * 0.11 + 2) * 0.35 + Math.sin(i * 1.3) * 0.1);
  return { h: Math.round(20 + v * 80), d: (0.6 + ((i * 7) % 10) / 12).toFixed(2), o: ((i * 13) % 17) / 17 };
});
const pad = (n: number) => String(n).padStart(2, '0');
---
{kind === 'line' ? (
  <div class={`cut cut--line tone-${tone}`} aria-hidden="true">
    <div class="wrap line"><span class="mono">✂ Cut · scène {pad(from)} → {pad(to)}</span></div>
  </div>
) : kind === 'film' ? (
  <div class={`cut cut--film tone-${tone}`} style={`--tilt:${tilt}deg`} aria-hidden="true">
    <div class="film">
      <div class="film__track">
        {[0, 1].map(() => (
          <span class="film__run">{words.map((w) => <span class="film__word">{w}<i>✦</i></span>)}</span>
        ))}
      </div>
    </div>
  </div>
) : (
  <div class={`cut cut--eq tone-${tone}`} aria-hidden="true">
    <div class="wrap eq__wrap">
      <span class="mono eq__tag">◀ Fin scène {pad(from)}</span>
      <div class="eq">
        {bars.map((b) => <i style={`--h:${b.h}%;--d:${b.d}s;--o:${b.o}`}></i>)}
      </div>
      <span class="mono eq__tag eq__tag--r">Scène {pad(to)} ▶</span>
    </div>
  </div>
)}

<style>
  .cut { --c: var(--gold); position: relative; z-index: 1; overflow: hidden; }
  .tone-pro { --c: var(--pro); }
  .tone-crea { --c: var(--crea); }

  /* Pellicule */
  .cut--line .line { display: flex; align-items: center; gap: 1rem; }
  .cut--line .line::before, .cut--line .line::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 45%, var(--line)), transparent); }
  .cut--line .mono { font-size: .58rem; color: color-mix(in srgb, var(--c) 70%, var(--muted)); }
  .cut--film { padding: 1.4rem 0; }
  .film {
    transform: rotate(var(--tilt)); margin: 0 -4vw;
    background: #07080c; border-block: 1px solid #000;
    box-shadow: 0 20px 50px -20px #000, 0 0 40px -10px color-mix(in srgb, var(--c) 35%, transparent);
    position: relative; padding: 13px 0;
  }
  .film::before, .film::after {
    content: ''; position: absolute; left: 0; right: 0; height: 8px;
    background: repeating-linear-gradient(90deg, #d5d9e2 0 10px, transparent 10px 22px); opacity: .5;
  }
  .film::before { top: 5px; } .film::after { bottom: 5px; }
  .film__track { display: flex; width: max-content; }
  .film__run { display: flex; flex: none; }
  .film__word {
    display: inline-flex; align-items: center; gap: 1.2rem; padding-right: 1.2rem; white-space: nowrap;
    font-family: var(--font-title); font-weight: 700; font-size: clamp(1.05rem, 2.2vw, 1.6rem); letter-spacing: -0.02em;
    color: var(--text);
  }
  .film__word:nth-child(even) { color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--c) 80%, #fff); }
  .film__word i { font-style: normal; color: var(--c); font-size: .6em; }

  /* Égaliseur */
  .cut--eq {
    padding: 1rem 0; margin: .6rem 0;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 9%, transparent) 20%, color-mix(in srgb, var(--c) 9%, transparent) 80%, transparent);
    border-block: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
  }
  .eq__wrap { display: flex; align-items: center; gap: 1rem; }
  .eq__tag { flex: none; font-size: .6rem; color: var(--c); }
  .eq { flex: 1; height: 54px; display: flex; align-items: center; gap: 3px; }
  .eq i {
    flex: 1; height: var(--h); border-radius: 2px; transform-origin: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 90%, #fff), var(--c) 45%, color-mix(in srgb, var(--c) 30%, transparent));
    opacity: calc(.35 + var(--o) * .5);
    box-shadow: 0 0 8px color-mix(in srgb, var(--c) 40%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .film__track { animation: roll 38s linear infinite; }
    .cut--film:nth-of-type(even) .film__track { animation-direction: reverse; }
    @keyframes roll { to { transform: translateX(-50%); } }
    .eq i { animation: eq var(--d) ease-in-out infinite alternate; animation-delay: calc(var(--o) * -1s); }
    @keyframes eq { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
  }
  @media (max-width: 640px) {
    .eq__tag { display: none; }
    .eq { height: 50px; gap: 2px; }
    .eq i:nth-child(2n) { display: none; }
  }
</style>
