---
import { experiences, formations, creaClips, lanes, timelineRange, type Clip } from '../data/cv';
import SectionHead from './SectionHead.astro';

// Valeurs de repli calculées à la construction ; le script les recalcule à la date du visiteur
const now = new Date();
const to = now.getFullYear() + timelineRange.yearsAhead;
const total = (to - timelineRange.from) * 12;
const toMonths = (d: string | null) => {
  if (!d) return (now.getFullYear() - timelineRange.from) * 12 + now.getMonth() + 1;
  const [y, m] = d.split('-').map(Number);
  return (y - timelineRange.from) * 12 + (m - 1);
};
const pos = (c: Clip) => {
  const s = toMonths(c.start);
  // Un clip en cours s'étire jusqu'au bord de la timeline, en fondu
  const e = c.end ? toMonths(c.end) : total;
  // Largeur exacte, moins un petit espace pour que deux clips voisins ne se touchent jamais
  return `left:calc(${(s / total) * 100}% + 1px);width:calc(${(Math.max(e - s, 1) / total) * 100}% - 2px)`;
};
const all = [...experiences, ...formations, ...creaClips];
// Un poste occupé plusieurs fois donne un clip par passage
const segments = all.flatMap((c) => [c, ...(c.more ?? []).map((m) => ({ ...c, start: m.start, end: m.end }))]);
const years = Array.from({ length: to - timelineRange.from }, (_, i) => timelineRange.from + i);
const nowPct = toMonths(null) / total;
const hrefFor = (c: Clip) => (c.track === 'crea' ? (c.id === 'contenu' ? '#hors-champ' : `#projet-${c.id}`) : `#clip-${c.id}`);
const first = experiences[0];
// Données de l'inspecteur, lues par le script
const laneLabel = Object.fromEntries(lanes.map((l) => [l.id, `${l.id} · ${l.label}`]));
// Durée d'un clip en mois (tous ses passages additionnés) ; recalculée par le script à la date du visiteur
const segMonths = (s: string, e: string | null) => Math.max(1, toMonths(e) - toMonths(s) + (e ? 1 : 0));
const durOf = (c: Clip) => [{ start: c.start, end: c.end }, ...(c.more ?? [])].reduce((n, x) => n + segMonths(x.start, x.end), 0);
const fmtDur = (n: number) => { const a = Math.floor(n / 12), m = n % 12; return [a ? `${a} an${a > 1 ? 's' : ''}` : '', m ? `${m} mois` : ''].filter(Boolean).join(' '); };
const inspect = Object.fromEntries(all.map((c) => [c.id, {
  t: c.title, o: c.org, sh: c.short ?? c.org, dur: c.dur ?? '', p: c.place ?? '', d: c.period, g: c.tag ?? '', pts: c.points, k: c.track, lane: laneLabel[c.lane],
  segs: [{ s: c.start, e: c.end }, ...(c.more ?? []).map((m) => ({ s: m.start, e: m.end }))],
}]));
const order = [...experiences, ...formations].map((c) => c.id);
---
<section class="section" id="parcours" aria-labelledby="parcours-title">
  <div class="wrap">
    <SectionHead scene={1} label="Parcours" title="La timeline" id="parcours-title">
      Chaque piste raconte une partie de mon parcours. Zoomez, survolez, cliquez sur un clip pour l’ouvrir dans l’inspecteur.
    </SectionHead>

    <div class="app depth reveal" data-tl data-from={timelineRange.from} data-ahead={timelineRange.yearsAhead} style={`--total:${total}`}>
      <div class="app__bar mono">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Séquence · parcours_marine</span>
        <div class="zoom" role="group" aria-label="Zoom de la timeline">
          <button type="button" data-zoom="-1" aria-label="Dézoomer">−</button>
          <input type="range" min="1" max="4" step="0.25" value="1" data-zoom-range aria-label="Niveau de zoom" />
          <button type="button" data-zoom="1" aria-label="Zoomer">+</button>
          <button type="button" class="fit" data-zoom-fit>Ajuster</button>
        </div>
      </div>

      <div class="tl">
        <div class="tl__heads" aria-hidden="true">
          <div class="tl__corner mono">Pistes</div>
          {lanes.map((l) => (
            <div class={`tl__head tl__head--${l.track}`}>
              <b class="mono">{l.id}</b><span>{l.label}</span>
              <i class="ico">{l.id.startsWith('V') ? '◉' : '♪'}</i>
            </div>
          ))}
        </div>
        <div class="tl__scroll" data-tl-scroll>
          <div class="tl__grid" data-tl-grid>
            <div class="tl__years" aria-hidden="true" data-tl-years>
              {years.map((y, i) => <span style={`left:${(i * 12 / total) * 100}%`}>{y}</span>)}
            </div>
            <ul class="tl__lanes" aria-label="Clips du parcours">
              {lanes.map((l) => (
                <li class="tl__lane">
                  {segments.filter((c) => c.lane === l.id).map((c) => (
                    <a class={`clip clip--${c.track} ${c.end ? '' : 'clip--live'}`} href={hrefFor(c)} style={pos(c)} data-clip={c.id} data-s={c.start} data-e={c.end ?? ''}
                       aria-label={`${c.title}, ${c.org}, ${c.period}`}>
                      <span class="clip__thumb" aria-hidden="true">{(c.short ?? c.org).slice(0, 1)}</span>
                      <span class="clip__name">{c.short ?? c.org}</span>
                    </a>
                  ))}
                </li>
              ))}
            </ul>
            <div class="tl__now" style={`--x:${nowPct}`} aria-hidden="true" data-tl-now><span class="mono">Aujourd’hui</span></div>
            <div class="tl__hover" data-tl-hover aria-hidden="true"><span class="mono"></span></div>
          </div>
        </div>
      </div>

      <div class="insp" data-insp data-k={first.track} aria-live="polite">
        <div class="insp__bar mono">
          <span class="insp__k">Inspecteur</span>
          <span class="insp__chip" data-i="lane">{laneLabel[first.lane]}</span>
          <span class="insp__nav">
            <button type="button" data-insp-step="-1" aria-label="Clip précédent">◀</button>
            <span data-i="pos">1 / {order.length}</span>
            <button type="button" data-insp-step="1" aria-label="Clip suivant">▶</button>
          </span>
        </div>
        <div class="insp__body">
          <div class="insp__main">
          <div class="insp__id">
            <span class="insp__thumb" data-i="thumb" aria-hidden="true">{(first.short ?? first.org).slice(0, 1)}</span>
            <div>
              <h3 data-i="t">{first.title}</h3>
              <p class="insp__org" data-i="o">{first.org}</p>
            </div>
          </div>
          <dl class="insp__props mono">
            <div><dt>Période</dt><dd data-i="d">{first.period}</dd></div>
            <div><dt>Durée</dt><dd data-i="dur">{first.dur ?? (first.track === 'formation' ? `${Math.round(durOf(first) / 12)} ans` : fmtDur(durOf(first)))}</dd></div>
            <div><dt>Lieu</dt><dd data-i="p">{first.place ?? '—'}</dd></div>
            <div><dt>Statut</dt><dd><span class={`tag ${first.tag && /obtenu/i.test(first.tag) ? 'tag--ok' : ''}`} data-i="g">{first.tag}</span></dd></div>
          </dl>
          </div>
          <div class="insp__pts" data-i="ptsbox">
            <p class="mono insp__ptk" data-i="ptk">Missions</p>
            <ul data-i="pts">{first.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
      <script type="application/json" data-insp-data set:html={JSON.stringify({ clips: inspect, order })} />
    </div>

    <div class="cols">
      {[{ title: 'Expériences', list: experiences }, { title: 'Formations', list: formations }].map((col) => (
        <div>
          <h3 class="col-title mono">{col.title}</h3>
          <ol class="cards">
            {col.list.map((c) => (
              <li class={`card card--${c.track} depth reveal`} id={`clip-${c.id}`}>
                <div class="card__meta mono">
                  <span data-since={c.end ? undefined : c.start}>{c.period}</span>
                  {c.tag && <span class={`tag ${/obtenu/i.test(c.tag) ? 'tag--ok' : ''}`}>{/obtenu/i.test(c.tag) && <span aria-hidden="true">✓ </span>}{c.tag}</span>}
                </div>
                <h4>{c.title}</h4>
                <p class="card__org">{c.org}{c.place && <span> · {c.place}</span>}</p>
                {c.points.length > 0 && (
                  <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .app { border-radius: 18px; overflow: hidden; margin-bottom: 3rem; }
  .app__bar {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: .6rem 1rem;
    background: linear-gradient(#222839, #1a1f2c); border-bottom: 1px solid #000;
    font-size: .68rem;
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .zoom { margin-left: auto; display: flex; align-items: center; gap: .4rem; }
  .zoom button {
    min-width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--line); cursor: pointer;
    background: var(--panel-2); color: var(--text); font: 600 .95rem var(--font-body);
  }
  .zoom .fit { padding: 0 .7rem; font-size: .75rem; }
  .zoom button:hover { border-color: var(--gold); }
  .zoom input { width: 120px; accent-color: var(--gold); }
  :global(html:not(.js)) .zoom { display: none; }

  .tl { display: flex; background: #0c0f16; }
  .tl__heads { width: 132px; flex: none; border-right: 1px solid #000; background: #151a25; z-index: 2; box-shadow: 6px 0 14px -8px rgb(0 0 0 / .8); }
  .tl__corner { height: 36px; display: flex; align-items: center; padding-left: .9rem; font-size: .62rem; border-bottom: 1px solid var(--line); }
  .tl__head {
    height: 48px; display: flex; align-items: center; gap: .55rem; padding: 0 .7rem 0 .9rem; font-size: .8rem;
    border-bottom: 1px solid #ffffff0a; position: relative;
  }
  .tl__head::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 0 3px 3px 0; }
  .tl__head--pro::before { background: var(--pro); }
  .tl__head--formation::before { background: var(--formation); }
  .tl__head--crea::before { background: var(--crea); }
  .tl__head b { font-size: .72rem; color: var(--text); }
  .tl__head span { color: var(--muted); }
  .ico { margin-left: auto; font-style: normal; color: var(--muted); font-size: .75rem; }

  .tl__scroll { flex: 1; overflow-x: auto; overflow-y: hidden; scrollbar-color: #3a4357 transparent; }
  .tl__grid { --zoom: 1; position: relative; width: calc(100% * var(--zoom)); min-width: 620px; padding-right: 1rem; }
  .tl__years {
    position: relative; height: 36px; border-bottom: 1px solid var(--line);
    background: repeating-linear-gradient(90deg, #ffffff12 0 1px, transparent 1px calc(100% / (var(--total) / 3)));
    background-size: 100% 8px; background-position: bottom; background-repeat: no-repeat;
  }
  .tl__years :global(span) {
    position: absolute; top: 0; height: 100%; padding: 8px 0 0 6px; border-left: 1px solid #ffffff22;
    font-family: var(--font-mono); font-size: .68rem; color: var(--muted);
  }
  .tl__lanes { list-style: none; }
  .tl__lane {
    position: relative; height: 48px; border-bottom: 1px solid #ffffff0a;
    background: repeating-linear-gradient(90deg, #ffffff06 0 1px, transparent 1px calc(100% / (var(--total) / 12)));
  }
  .clip {
    position: absolute; top: 7px; bottom: 7px; z-index: 2; border-radius: 7px; overflow: hidden; container-type: inline-size;
    display: flex; align-items: center; gap: .45rem; padding: 0 .45rem 0 .25rem; text-decoration: none;
    font-size: .74rem; font-weight: 600; white-space: nowrap; color: #0b0d13;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .45), inset 0 -2px 0 rgb(0 0 0 / .18), 0 4px 10px rgb(0 0 0 / .45);
    transition: filter .2s, transform .2s, box-shadow .2s;
  }
  .clip:hover, .clip:focus-visible { filter: brightness(1.12); transform: translateY(-2px); z-index: 3; }
  .clip.is-selected { outline: 2px solid #fff; outline-offset: 1px; z-index: 3; }
  .clip { padding-left: .25rem; }
  .clip__thumb {
    width: 24px; height: 24px; flex: none; border-radius: 5px; display: grid; place-items: center;
    background: rgb(0 0 0 / .22); color: rgb(255 255 255 / .9); font-size: .7rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .15);
  }
  .clip__name { overflow: hidden; text-overflow: ellipsis; }
  .clip:not(.clip--crea) { padding-right: .25rem; }
  /* Les clips étroits se simplifient : d'abord sans vignette, puis sans texte */
  @container (max-width: 90px) { .clip__thumb { display: none; } .clip__name { padding-left: .2rem; } }
  @container (max-width: 34px) { .clip__name { display: none; } }
  .clip--pro { background: linear-gradient(180deg, #5fe0cf, var(--pro) 55%, #2aa596); }
  .clip--formation { background: linear-gradient(180deg, #ffd34d, var(--formation) 55%, #cf9b00); }
  .clip--crea {
    color: var(--text); border: 1px solid color-mix(in srgb, var(--crea) 70%, transparent);
    background:
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--crea) 65%, transparent) 0 2px, transparent 2px 5px) center / 100% 46% no-repeat,
      linear-gradient(180deg, #4a3a85, #2a2150);
  }
  .clip--crea .clip__name { background: #1d1638cc; padding: 0 .35rem; border-radius: 4px; }
  .clip--crea .clip__thumb { background: var(--crea); color: #120d22; }
  .clip--live { -webkit-mask: linear-gradient(90deg, #000 88%, #0000); mask: linear-gradient(90deg, #000 88%, #0000); }

  .tl__now, .tl__hover { position: absolute; top: 0; bottom: 0; width: 2px; pointer-events: none; }
  .tl__now { left: calc((100% - 1rem) * var(--x)); background: var(--rec); box-shadow: 0 0 12px var(--rec); z-index: 1; opacity: .9; }
  .tl__now span { position: absolute; top: 21px; right: 5px; color: var(--rec); font-size: .58rem; line-height: 1.4; white-space: nowrap; background: #0c0f16; padding: 0 .3rem; border-radius: 3px; }
  .tl__hover { left: 0; background: #ffffff70; opacity: 0; transition: opacity .15s; z-index: 4; }
  .tl__hover span { position: absolute; top: 3px; left: 6px; font-size: .6rem; color: #fff; white-space: nowrap; background: #000a; padding: 0 .3rem; border-radius: 3px; }
  .tl__hover.is-on { opacity: 1; }

  /* Inspecteur, façon panneau de propriétés d'un logiciel de montage */
  .insp { --c: var(--pro); border-top: 1px solid #000; background: linear-gradient(#171c28, #131722); }
  .insp[data-k='formation'] { --c: var(--formation); }
  .insp[data-k='crea'] { --c: var(--crea); }
  .insp__bar { display: flex; align-items: center; gap: .8rem; padding: .55rem 1rem; font-size: .62rem;
    background: linear-gradient(#1d2333, #181d2a); border-bottom: 1px solid #000; }
  .insp__k { color: var(--gold); }
  .insp__chip { padding: .15rem .55rem; border-radius: 999px; color: #0b0d13; background: var(--c); font-weight: 700; }
  .insp__nav { margin-left: auto; display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); }
  .insp__nav button { width: 28px; height: 26px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); cursor: pointer; font-size: .7rem; }
  .insp__nav button:hover { border-color: var(--c); color: var(--c); }
  .insp__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 1.8rem; align-items: start; padding: 1.3rem 1.4rem 1.5rem; }
  .insp__main { display: grid; gap: 1.1rem; }
  .insp__id { display: flex; gap: 1rem; align-items: flex-start; }
  .insp__thumb {
    width: 64px; height: 64px; flex: none; border-radius: 12px; display: grid; place-items: center;
    font: 700 1.7rem var(--font-title); color: #0b0d13;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 70%, #fff), var(--c) 55%, color-mix(in srgb, var(--c) 60%, #000));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 6px 14px -10px color-mix(in srgb, var(--c) 60%, transparent);
  }
  .insp h3 { font-size: 1.35rem; line-height: 1.2; }
  .insp__org { color: color-mix(in srgb, var(--c) 70%, var(--muted)); margin-top: .3rem; }
  .insp__props { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.4rem; font-size: .7rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .insp__props div { display: grid; gap: .2rem; padding: .45rem 0; border-bottom: 1px dashed #ffffff0f; }
  .insp__props .tag { white-space: nowrap; display: inline-block; }
  .insp__props dt { color: var(--muted); }
  .insp__props dd { margin: 0; color: var(--text); text-transform: none; letter-spacing: .02em; }
  .insp__pts { border-left: 1px solid var(--line); padding-left: 1.2rem; }
  .insp__pts[hidden] { display: none; }
  .insp__ptk { font-size: .6rem; color: var(--muted); margin-bottom: .5rem; }
  .insp__pts ul { list-style: none; padding: 0; display: grid; gap: .45rem; font-size: .93rem; color: #d5d9e2; }
  .insp__pts :global(li) { position: relative; padding-left: 1.1rem; }
  .insp__pts :global(li)::before { content: ''; position: absolute; left: 0; top: .5em; width: 7px; height: 7px; background: var(--c); transform: rotate(45deg); border-radius: 1px; }
  .insp.is-swap .insp__body { animation: swap .35s ease; }
  @keyframes swap { from { opacity: 0; transform: translateY(6px); } }
  .tag { color: var(--text); border: 1px solid var(--line); border-radius: 999px; padding: .05rem .55rem; text-transform: none; }
  .tag:empty { display: none; }
  /* Diplôme obtenu : badge vert plein, comme sur le CV */
  .tag--ok {
    color: #06240f; background: linear-gradient(180deg, #7be495, #4cc46a); border-color: #2e9a4b;
    font-weight: 700; box-shadow: 0 0 0 3px rgb(76 196 106 / .18), 0 4px 12px -4px rgb(76 196 106 / .6);
  }

  .cols { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.5rem; }
  .col-title { margin-bottom: 1rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .card { position: relative; padding: 1.3rem 1.4rem 1.3rem 1.6rem; border-radius: var(--radius); scroll-margin-top: 100px; }
  .card::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 0 3px 3px 0; }
  .card--pro::before { background: var(--pro); }
  .card--formation::before { background: var(--formation); }
  .card:target { border-color: var(--gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 25%, transparent); }
  .card__meta { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .45rem; font-size: .72rem; }
  .card h4 { font-size: 1.25rem; line-height: 1.25; }
  .card__org { color: var(--muted); font-size: .95rem; margin-top: .25rem; }
  .card--pro .card__org { color: color-mix(in srgb, var(--pro) 70%, var(--muted)); }
  .card--formation .card__org { color: color-mix(in srgb, var(--formation) 65%, var(--muted)); }
  .card ul { margin-top: .75rem; padding-top: .75rem; border-top: 1px dashed var(--line); padding-left: 1.1rem; display: grid; gap: .35rem; font-size: .96rem; color: #d5d9e2; }
  .card li::marker { color: var(--muted); }

  @media (max-width: 860px) {
    .cols, .insp__body { grid-template-columns: 1fr; }
    .insp__pts { border-left: 0; padding-left: 0; }
    .tl__heads { width: 92px; }
    .tl__head span, .ico { display: none; }
    .zoom input { display: none; }
  }
</style>
