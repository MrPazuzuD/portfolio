---
import { profile, sections } from '../data/cv';
import { achievements } from '../data/achievements';
---
<header class="hdr">
  <div class="hdr__bar wrap">
    <a class="brand" href="#top" aria-label="Retour en haut de page">
      <span class="brand__mark" aria-hidden="true">MR</span>
      <span class="brand__tc mono" aria-hidden="true"><span data-tc>00:00:00:00</span> <span class="brand__dur">/ 00:02:00:00</span></span>
    </a>

    <nav class="nav" aria-label="Sections">
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`} data-nav={s.id}>{s.label}</a></li>)}
      </ul>
    </nav>

    <button type="button" class="trophy" data-ach-open aria-haspopup="dialog" aria-label="Succès débloqués">
      <span aria-hidden="true">🏆</span><span class="mono"><span data-ach-count>0</span>/{achievements.length}</span>
    </button>
    <a class="btn btn--gold hdr__cv" href={profile.cvPdf} download>CV</a>

    <details class="menu">
      <summary>Menu</summary>
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        <li><a href={profile.cvPdf} download>Télécharger le CV</a></li>
      </ul>
    </details>
  </div>

  <!-- Règle de timeline : la tête de lecture suit le défilement -->
  <div class="ruler" aria-hidden="true">
    <div class="ruler__ticks"></div>
    <div class="ruler__fill" data-fill></div>
    <div class="ruler__head" data-head></div>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .hdr__bar { height: var(--header-h); display: flex; align-items: center; gap: 1.5rem; }
  .trophy, .hdr__cv { flex: none; white-space: nowrap; }
  .brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; }
  .brand__mark {
    font-family: var(--font-title); font-weight: 700; font-size: .95rem; color: #14110a;
    background: var(--gold); padding: .3rem .45rem .45rem; line-height: 1;
    clip-path: polygon(0 0, 100% 0, 100% 75%, 50% 100%, 0 75%);
  }
  .brand__tc { color: var(--text); font-variant-numeric: tabular-nums; }
  .brand__dur { color: var(--muted); }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; display: flex; gap: .25rem; }
  .nav a {
    display: block; padding: .45rem .8rem; border-radius: 999px; text-decoration: none; white-space: nowrap;
    font-size: .92rem; color: var(--muted); transition: color .2s, background .2s;
  }
  .nav a:hover, .nav a.is-active { color: var(--text); background: var(--panel-2); }
  .hdr__cv { padding: .5rem 1rem; }
  .trophy {
    display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .75rem; border-radius: 999px; cursor: pointer;
    background: var(--panel-2); border: 1px solid var(--line); color: var(--text); font: inherit;
  }
  .trophy .mono { color: var(--text); font-size: .72rem; }
  .trophy:hover { border-color: var(--gold); }
  .trophy.is-bump { animation: bump .5s ease; }
  @keyframes bump { 40% { transform: scale(1.18); border-color: var(--gold); } }
  :global(html:not(.js)) .trophy { display: none; }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none; cursor: pointer; padding: .5rem .9rem; border: 1px solid var(--line);
    border-radius: 999px; font-size: .9rem; font-weight: 600;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul {
    position: absolute; right: 0; top: calc(100% + .6rem); list-style: none; min-width: 220px;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: .5rem;
    box-shadow: 0 20px 40px rgb(0 0 0 / .4);
  }
  .menu a { display: block; padding: .7rem .9rem; border-radius: 10px; text-decoration: none; }
  .menu a:hover { background: var(--panel-2); }

  .ruler { position: relative; height: 10px; }
  .ruler__ticks {
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(90deg, #39415499 0 1px, transparent 1px 2.5%),
      repeating-linear-gradient(90deg, #39415466 0 1px, transparent 1px .5%);
    background-size: 100% 100%, 100% 45%;
    background-repeat: no-repeat;
  }
  .ruler__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: color-mix(in srgb, var(--gold) 18%, transparent); }
  .ruler__head { position: absolute; top: 0; bottom: -2px; left: 0; width: 2px; background: var(--rec); box-shadow: 0 0 10px var(--rec); }
  .ruler__head::before {
    content: ''; position: absolute; top: 0; left: -4px; width: 10px; height: 6px; background: var(--rec);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  @media (max-width: 1100px) { .brand__dur { display: none; } .nav a { padding: .45rem .6rem; } .hdr__bar { gap: 1rem; } }
  @media (max-width: 960px) {
    .nav, .hdr__cv, .brand__dur { display: none; }
    .menu { display: block; }
    .trophy { margin-left: auto; }
  }
</style>
