---
import { projects } from '../data/cv';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const chat = [
  { u: 'viewer_42', c: '#7ec8ff', m: 'GG pour le palier des 500 € !' },
  { u: 'pazuzuuu_', c: '#a98bff', m: 'Merci à tous, on continue 💜', mod: true },
  { u: 'spam_bot', c: '#ff8f8f', m: '', del: true },
  { u: 'lunaire', c: '#ffd27e', m: 'Don de 10 € pour l’asso !', don: true },
  { u: 'kevin_88', c: '#8fffc1', m: 'Le clip du boss était énorme' },
];
---
<section class="section" id="projets" aria-labelledby="projets-title">
  <div class="wrap">
    <SectionHead scene={3} label="Projets" title="Ce que je fabrique" id="projets-title">
      Des projets nés d’un vrai besoin ou d’une bande de copains.
    </SectionHead>

    <div class="list">
      {projects.map((p, i) => (
        <article class="proj depth reveal" id={`projet-${p.id}`}>
          <div class="proj__text">
            <p class="mono proj__meta"><span>{String(i + 1).padStart(2, '0')}</span>{p.kind} · {p.year}</p>
            <h3>{p.name}</h3>
            <p class="proj__sum">{p.summary}</p>
            {p.points.length > 0 && <ul class="pts">{p.points.map((x) => <li>{x}</li>)}</ul>}
            <ul class="stack">{p.stack.map((s) => <li class="mono">{s}</li>)}</ul>
            {p.link ? (
              <a class="btn" href={p.link} target="_blank" rel="noopener">{p.linkLabel}<Icon name="arrow" /></a>
            ) : p.linkLabel && <p class="soon mono">{p.linkLabel}</p>}
          </div>

          <div class="visual">
            {p.id === 'video-toolbox' && (
              <figure class="shot">
                <button type="button" class="shot__win tilt" data-zoom-img="/video-toolbox.webp" aria-label="Agrandir la capture de Video Toolbox">
                  <span class="shot__bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><b>Video Toolbox</b><span class="mono">Agrandir ⤢</span></span>
                  <img src="/video-toolbox.webp" alt="Capture de Video Toolbox : liste de vidéos analysées avec leur verdict de compatibilité TV, réglages de conversion et conversion en cours" width="1440" height="820" loading="lazy" decoding="async" />
                </button>
                <figcaption class="mono">Vraie capture de l’application, prise sur une machine de test sans carte graphique (d’où « GPU : non disponible »).</figcaption>
              </figure>
            )}

            {'youtube' in p && p.youtube && (
              <div class="player" data-yt={p.youtube.id}>
                <a class="player__facade" href={`https://www.youtube.com/watch?v=${p.youtube.id}`} target="_blank" rel="noopener">
                  <img class="player__img" src={p.youtube.thumb} alt="" width="960" height="540" loading="lazy" decoding="async" />
                  <span class="player__shade" aria-hidden="true"></span>
                  <span class="player__btn" aria-hidden="true"><Icon name="play" /></span>
                  <span class="player__label mono" aria-hidden="true">Bande-annonce</span>
                  <span class="sr-only">{p.youtube.title} (YouTube)</span>
                </a>
                <p class="player__note mono">La vidéo se charge depuis YouTube au clic.</p>
              </div>
            )}

            {p.id === 'caritatif' && (
              <div class="chat tilt" aria-hidden="true">
                <div class="chat__head"><span class="live mono">● En direct</span><b>Chat du live</b></div>
                <div class="chat__goal">
                  <div class="mono"><span>Objectif de dons</span><span>78 %</span></div>
                  <span class="bar"><i></i></span>
                </div>
                <ul class="chat__msgs">
                  {chat.map((c, k) => (
                    <li style={`--k:${k}`} class={c.don ? 'is-don' : ''}>
                      {c.mod && <span class="badge" title="Modératrice">⚔</span>}
                      <b style={`color:${c.c}`}>{c.u}</b>
                      {c.del ? <em>message supprimé par un modérateur</em> : <span>{c.m}</span>}
                    </li>
                  ))}
                </ul>
                <p class="chat__note mono">Illustration</p>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
  <dialog class="zoom" data-zoom-dialog aria-label="Capture agrandie">
    <button type="button" class="zoom__close" data-zoom-close aria-label="Fermer">✕</button>
    <img alt="" data-zoom-target />
  </dialog>
</section>

<style>
  .list { display: grid; gap: 1.4rem; }
  .proj {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center;
    padding: clamp(1.4rem, 3vw, 2.4rem); border-radius: 22px; scroll-margin-top: 100px; overflow: hidden;
  }
  .proj:nth-child(even) .proj__text { order: 2; }
  .proj__meta { display: flex; gap: .8rem; font-size: .7rem; }
  .proj__meta span { color: var(--gold); }
  .proj h3 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: .4rem 0 .8rem; }
  .proj__sum { color: #d5d9e2; max-width: 62ch; }
  .pts { margin-top: 1rem; padding-left: 1.1rem; display: grid; gap: .35rem; color: #c9cedb; font-size: .96rem; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.2rem 0; }
  .stack li { font-size: .66rem; padding: .25rem .6rem; border: 1px solid var(--line); border-radius: 999px; color: var(--text); }
  .soon { color: var(--gold); font-size: .7rem; }
  .visual { perspective: 1200px; }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }

  /* Capture Video Toolbox */
  .shot { margin: 0; display: grid; gap: .6rem; }
  .shot__win {
    all: unset; box-sizing: border-box; cursor: zoom-in; display: block; border-radius: 12px; overflow: hidden; background: #1e1e1e;
    border: 1px solid #000; box-shadow: 0 30px 70px -20px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .08);
  }
  .shot__win:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .shot__bar { display: flex; align-items: center; gap: .8rem; padding: .5rem .8rem; background: linear-gradient(#3a3d44, #2d3036); border-bottom: 1px solid #000; font-size: .8rem; }
  .shot__bar b { font-family: var(--font-title); font-weight: 600; }
  .shot__bar .mono { margin-left: auto; font-size: .6rem; }
  .shot img { width: 100%; height: auto; }
  .shot figcaption { font-size: .6rem; text-transform: none; }

  .zoom { padding: 0; border: 0; background: transparent; max-width: 96vw; max-height: 94vh; overflow: visible; }
  .zoom::backdrop { background: rgb(5 7 12 / .85); backdrop-filter: blur(4px); }
  .zoom img { display: block; max-width: 96vw; max-height: 94vh; border-radius: 10px; box-shadow: 0 40px 120px #000; }
  .zoom__close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); cursor: pointer; }

  /* Lecteur Miratopia */
  .player { display: grid; gap: .6rem; }
  .player__facade, .player :global(iframe) {
    position: relative; display: grid; place-items: center; aspect-ratio: 16 / 9; width: 100%;
    border-radius: 14px; border: 1px solid #000; overflow: hidden; text-decoration: none;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .08);
  }
  .player__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .player__facade:hover .player__img { transform: scale(1.04); }
  .player__shade { position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgb(5 8 15 / .15), rgb(5 8 15 / .6)); }
  .player__label { position: absolute; right: 1rem; top: 1rem; font-size: .6rem; padding: .25rem .55rem; background: #000a; border-radius: 6px; }
  .player__btn {
    position: relative; width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center;
    background: var(--gold); color: #14110a; transition: transform .25s ease;
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--gold) 22%, transparent), 0 10px 30px rgb(0 0 0 / .6);
  }
  .player__btn :global(svg) { width: 32px; height: 32px; margin-left: 4px; }
  .player__facade:hover .player__btn { transform: scale(1.1); }
  .player__note { font-size: .62rem; text-transform: none; }

  /* Chat de live */
  .chat { border-radius: 14px; overflow: hidden; background: #0e0e10; border: 1px solid #000;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .08); font-size: .88rem; }
  .chat__head { display: flex; align-items: center; gap: .8rem; padding: .7rem 1rem; background: #18181b; border-bottom: 1px solid #2a2a2e; }
  .live { color: #ff4d4f; font-size: .6rem; }
  .chat__goal { padding: .7rem 1rem; border-bottom: 1px solid #2a2a2e; display: grid; gap: .4rem; }
  .chat__goal div { display: flex; justify-content: space-between; font-size: .6rem; }
  .bar { height: 6px; border-radius: 3px; background: #2a2a2e; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 78%; background: linear-gradient(90deg, var(--crea), #ff6ec7); }
  .chat__msgs { list-style: none; padding: .7rem 1rem; display: grid; gap: .45rem; }
  .chat__msgs li { line-height: 1.4; }
  .chat__msgs b { margin-right: .35rem; }
  .chat__msgs em { color: #77777f; font-size: .82rem; }
  .chat__msgs .is-don { padding: .45rem .6rem; border-radius: 8px; background: color-mix(in srgb, var(--crea) 22%, #0e0e10); border-left: 3px solid var(--crea); }
  .badge { display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: .3rem; border-radius: 4px; background: #00ad03; color: #fff; font-size: .7rem; vertical-align: -3px; }
  .chat__note { padding: 0 1rem .7rem; font-size: .55rem; color: #55555c; }

  @media (prefers-reduced-motion: no-preference) {
    .vt__prog i { animation: prog 3.2s ease-in-out infinite; }
    @keyframes prog { from { width: 8%; } to { width: 96%; } }
    :global(.js) .reveal .chat__msgs li { opacity: 0; transform: translateY(8px); }
    :global(.js) .reveal.is-in .chat__msgs li { animation: msg .45s ease forwards; animation-delay: calc(.4s + var(--k) * .55s); }
    @keyframes msg { to { opacity: 1; transform: none; } }
    :global(.js) .reveal.is-in .bar i { animation: goal 1.6s 2.4s ease both; }
    @keyframes goal { from { width: 40%; } }
  }
  @media (max-width: 860px) {
    .proj { grid-template-columns: 1fr; }
    .proj:nth-child(even) .proj__text { order: 0; }
  }
</style>
