---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Monitor from '../components/Monitor.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import HorsChamp from '../components/HorsChamp.astro';
import Contact from '../components/Contact.astro';
import Achievements from '../components/Achievements.astro';
import Waves from '../components/Waves.astro';
import Cut from '../components/Cut.astro';
import { profile } from '../data/cv';
---
<Base
  title={`${profile.firstName} ${profile.lastName} · ${profile.title}`}
  description={`${profile.title} à ${profile.location}. Parcours, compétences, projets, et tout ce qui se passe hors champ : musique, montage et jeux vidéo.`}
>
  <a class="skip" href="#main">Aller au contenu</a>
  <Waves />
  <Header />
  <main id="main">
    <Monitor />
    <Cut kind="film" tone="pro" tilt={-1.2} words={['Support N1/N2', 'Windows', 'Debian', 'Active Directory', 'GLPI', 'WAPT', 'PowerShell', 'Python', 'Pédagogie']} />
    <Timeline />
    <Cut kind="line" tone="pro" from={1} to={2} />
    <Skills />
    <Cut kind="line" tone="gold" from={2} to={3} />
    <Projects />
    <Cut kind="eq" tone="crea" from={3} to={4} />
    <HorsChamp />
    <Cut kind="line" tone="crea" from={4} to={5} />
    <Contact />
  </main>
  <Achievements />
  <script src="../scripts/main.ts"></script>
</Base>
